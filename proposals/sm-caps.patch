+def _read_capped(resp, max_bytes: int, timeout: float, clock=time.monotonic) -> bytes:
+    """Body read with a size cap and a whole-body deadline equal to ``timeout`` (read1; clock checked before each read and after
+    every read including the terminal empty one). Chunk framing, header and trailer drip are NOT bounded by this deadline.
+    Errors are generic ValueErrors with no body, URL or size detail; probe() already turns ValueError into an error entry."""
