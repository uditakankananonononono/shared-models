+def _base_checkpoint_sha(path_str: str | None) -> str | None:
+    """sha256 of the base checkpoint file; None ONLY when no path was provided.
+
+    A provided path (including the default string) that is missing, not a regular file, or cannot be inspected or read is a
+    name-only ValueError raised before any training starts. Symlinks are followed (the file that would be read is hashed)."""
+    if path_str is None:
+        return None
+    p = Path(path_str)
+    try:
+        st = p.stat()
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"base checkpoint not found: {p.name}") from exc
+    except (OSError, ValueError) as exc:
+        raise ValueError(f"base checkpoint cannot be inspected: {p.name}") from exc
+    if not stat.S_ISREG(st.st_mode):
+        raise ValueError(f"base checkpoint is not a regular file: {p.name}")
+    h = hashlib.sha256()
+    try:
+        with open(p, "rb") as f:
+            for chunk in iter(lambda: f.read(1 << 20), b""):
+                h.update(chunk)
+    except OSError as exc:
+        raise ValueError(f"base checkpoint is not readable: {p.name}") from exc
+    return h.hexdigest()
+
